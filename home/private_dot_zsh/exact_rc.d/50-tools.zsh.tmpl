# Tool integrations, each guarded so a missing binary can't break startup.

# mise-en-place (replaces volta, pyenv). Activated first so mise-managed
# binaries (e.g. starship) are already on PATH for the inits below.
[[ -x ~/.local/bin/mise ]] && eval "$(~/.local/bin/mise activate zsh)"

# fzf: source command, options/theme (shared ~/.config/fzf/fzfrc), key bindings
# and fuzzy completion
export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS_FILE=~/.config/fzf/fzfrc
# CTRL-T / ALT-C default to fzf's built-in walker (ignores .gitignore); use fd
# like bare `fzf`. CTRL-R belongs to atuin: an empty command stops fzf binding it.
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'
export FZF_CTRL_R_COMMAND=
(( $+commands[fzf] )) && eval "$(fzf --zsh)"

# zoxide: jump between folders efficiently
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# Starship prompt
export STARSHIP_CONFIG=~/.config/starship/starship.toml
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Atuin history search
(( $+commands[atuin] )) && eval "$(atuin init zsh)"

# yazi: `y` changes into the directory yazi was in when it quit
# (https://yazi-rs.github.io/docs/quick-start#shell-wrapper)
function y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
  command rm -f -- "$tmp"
}

