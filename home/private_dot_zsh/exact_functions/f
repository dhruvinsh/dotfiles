# Run a command and pipe its output into fzf: `f <cmd…> -- <fzf args…>`
local cmd=()
local fzf_args=()
local found_sep=0
for arg in "$@"; do
  if [ "$arg" = "--" ]; then
    found_sep=1
    continue
  fi
  if [ $found_sep -eq 0 ]; then
    cmd+=("$arg")
  else
    fzf_args+=("$arg")
  fi
done
"${cmd[@]}" | fzf "${fzf_args[@]}"
