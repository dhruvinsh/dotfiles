$Env:Path = "$Env:USERPROFILE\.local\bin;$env:Path"
$Env:NVIM_COLORSCHEME = {{ .colorScheme.name | quote }}

# zoxide
if (Get-Command zoxide -errorAction SilentlyContinue)
{
  Set-Alias z zoxide
  Invoke-Expression (& { (zoxide init powershell | Out-String) })
}

if (Get-Command volta -errorAction SilentlyContinue)
{
  (& volta completions powershell) | Out-String | Invoke-Expression
}

# adding auto-completion support for uv
(& uv generate-shell-completion powershell) | Out-String | Invoke-Expression
(& uvx --generate-shell-completion powershell) | Out-String | Invoke-Expression

# mise shims: persist to the User PATH once (only affects new processes), and
# prepend to this session's PATH so mise-managed tools like starship resolve now
$shimPath = "$env:USERPROFILE\AppData\Local\mise\shims"
$currentPath = [Environment]::GetEnvironmentVariable('Path', 'User')
if ($currentPath -notlike "*$shimPath*")
{
  [Environment]::SetEnvironmentVariable('Path', "$currentPath;$shimPath", 'User')
}
if ($Env:Path -notlike "*$shimPath*")
{
  $Env:Path = "$shimPath;$Env:Path"
}

# starship config (installed via mise)
if (Get-Command starship -errorAction SilentlyContinue)
{
  $ENV:STARSHIP_CACHE = "$HOME\AppData\Local\Temp"
  $ENV:STARSHIP_CONFIG = "$HOME\.config\starship\starship.toml"
  Invoke-Expression (&starship init powershell)
}

# eza listing (PowerShell aliases can't take arguments, so these are functions;
# the built-in `ls` alias for Get-ChildItem is removed first)
if (Get-Command eza -errorAction SilentlyContinue)
{
  Remove-Item Alias:ls -Force -ErrorAction SilentlyContinue
  function ls { eza --group-directories-first --icons=auto --hyperlink=auto @args }
  function l { ls -la --git @args }
  function la { ls -la --git @args }
  function ll { ls -l --git @args }
  function lt { ls --tree --level=2 @args }
}

# yazi: `y` changes into the directory yazi was in when it quit
# https://yazi-rs.github.io/docs/quick-start#shell-wrapper
function y {
  $tmp = (New-TemporaryFile).FullName
  yazi.exe @args --cwd-file="$tmp"
  $cwd = Get-Content -Path $tmp -Encoding UTF8
  if ($cwd -and $cwd -ne $PWD.Path -and (Test-Path -LiteralPath $cwd -PathType Container)) {
    Set-Location -LiteralPath (Resolve-Path -LiteralPath $cwd).Path
  }
  Remove-Item -Path $tmp
}
