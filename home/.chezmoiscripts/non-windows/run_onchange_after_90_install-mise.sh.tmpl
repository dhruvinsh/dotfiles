#!/usr/bin/env bash
# vim: set expandtab ts=4 sw=4 ft=sh:

set -euo pipefail

# make sure all the necessary binary in path. ~/.local/bin is where mise.run installs
# mise; on a fresh install the first-login shell doesn't have it on PATH yet.
[ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
export PATH="$HOME/.local/bin:$PATH"


if [ ! "$(command -v mise)" ]; then
    echo "Install node with help of mise ⚡️"
    curl https://mise.run | sh

fi

# mise/config.toml sha256: {{  include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}
echo "Install/update mise packages 📦"
mise self-update --yes
mise install
mise upgrade
