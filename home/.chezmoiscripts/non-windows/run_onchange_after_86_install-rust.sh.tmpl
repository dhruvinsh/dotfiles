#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:

set -euo pipefail

# -y: no prompt; --no-modify-path: .zshenv already sources ~/.cargo/env, and rustup
# appending to the managed ~/.profile makes it drift from chezmoi.
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path

# install tools only in linux system
# {{ if (and (eq .chezmoi.os "linux") (not .archlinux)) }}
cargo_packages=(
    ast-grep
    diffr
)

[ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
cargo install "${cargo_packages[@]}"
# {{ end }}
