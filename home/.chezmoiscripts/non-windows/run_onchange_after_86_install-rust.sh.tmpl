#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:

set -euo pipefail

# -y: no prompt; --no-modify-path: .zshenv already sources ~/.cargo/env, and rustup
# appending to the managed ~/.profile makes it drift from chezmoi.
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --no-modify-path --profile default --default-toolchain stable
# rustup-init keeps an existing install's settings, so pin the default explicitly too
"$HOME/.cargo/bin/rustup" default stable
