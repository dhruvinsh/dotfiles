# vim: set ft=powershell

try {
  if (Get-Command scoop) {
    $packages = @(
      "main/nodejs-lts"
      "nerd-fonts/CascadiaCode-NF"
    );

    foreach ($package in $packages) {
      Write-Output "--> Uninstalling $package.."
      scoop uninstall $package
    }
  }
}
catch {
  Write-Output "Scoop not found, assuming new setup."
}

try {
  if (Get-Command pipx) {
    Write-Output "Removing pipx packages."
    pipx uninstall-all
    pip uninstall -y pipx
  }
}
catch {
  Write-Output "pipx not found."
}

if (scoop list | Select-String -Pattern '^volta\s') {
    scoop uninstall volta
} else {
    Write-Output "--> Volta is not installed."
}

Write-Output "Removing gitconfig.."
rm ~/.gitconfig

Write-Output "Removing direnv package.."
scoop uninstall direnv

Write-Output "Removing wezterm (ghostty only).."
if (scoop list | Select-String -Pattern '^wezterm\s') {
  scoop uninstall extras/wezterm
} else {
  Write-Output "--> wezterm is not installed."
}
# cached WSL IP used only by the wezterm ssh domain
Remove-Item -Force -ErrorAction SilentlyContinue "$HOME/.wsl_ip"

Write-Output "Removing mise migrated packages..."
foreach ($package in @("ast-grep", "delta", "glow", "gitleaks", "git-cliff", "just", "starship", "television")) {
  if (scoop list | Select-String -Pattern "^$package\s") {
    scoop uninstall "main/$package"
  } else {
    Write-Output "--> $package is not installed."
  }
}
