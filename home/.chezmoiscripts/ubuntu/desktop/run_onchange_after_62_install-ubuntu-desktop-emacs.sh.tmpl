#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:
#
# Installs Emacs from https://github.com/dhruvinsh/emacs-builds, which builds
# native-compiled .debs per Ubuntu release in CI (emacs-wayland = pgtk,
# emacs-x11 = GTK3). The release asset is resolved when chezmoi renders this
# script, so a new release changes the script and run_onchange_ reinstalls.

set -euo pipefail

{{ template "scripts/download_helpers.sh" . }}

# {{- $flavour := "emacs-x11" -}}
# {{- if eq (env "XDG_SESSION_TYPE") "wayland" -}}
# {{-   $flavour = "emacs-wayland" -}}
# {{- end -}}
# {{- $asset := printf "^%s_.*~ubuntu%s_amd64\\.deb$" $flavour (.chezmoi.osRelease.versionID | regexQuoteMeta) -}}
# {{- $url := "" -}}
# {{- $tag := "" -}}
# {{- range (gitHubReleases "dhruvinsh/emacs-builds") -}}
# {{-   if and (not $url) (not .GetDraft) (not .GetPrerelease) -}}
# {{-     range .Assets -}}
# {{-       if regexMatch $asset .GetName -}}
# {{-         $url = .GetBrowserDownloadURL -}}
# {{-       end -}}
# {{-     end -}}
# {{-     if $url -}}
# {{-       $tag = .GetTagName -}}
# {{-     end -}}
# {{-   end -}}
# {{- end }}

EMACS_PKG={{ $flavour | quote }}
EMACS_RELEASE={{ $tag | quote }}
EMACS_DEB_URL={{ $url | quote }}

if [[ -z "${EMACS_DEB_URL}" ]]; then
    echo "No ${EMACS_PKG} release for Ubuntu {{ .chezmoi.osRelease.versionID }} in dhruvinsh/emacs-builds yet, skipping."
    exit 0
fi

# Emacs used to be built from source into /usr/local, which comes first on
# PATH and would shadow the package. Remove whatever the package now ships
# under /usr from /usr/local, plus the old versioned trees.
remove_old_source_build() {
    [[ -e /usr/local/bin/emacs ]] || return 0
    echo "Removing old source-built Emacs from /usr/local"

    local file old
    while read -r file; do
        case "${file}" in
        /usr/share/emacs/* | /usr/lib/emacs/* | /usr/libexec/emacs/*) continue ;;
        /usr/*) ;;
        *) continue ;;
        esac
        old="/usr/local${file#/usr}"
        if [[ -f "${old}" || -L "${old}" ]]; then
            sudo rm -f "${old}"
        fi
    done < <(dpkg-query -L "${EMACS_PKG}")

    # The gschema is only installed by pgtk builds, so emacs-x11 can't match it.
    sudo rm -rf /usr/local/bin/emacs-[0-9]* /usr/local/lib/emacs /usr/local/libexec/emacs \
        /usr/local/share/emacs/[0-9]* /usr/local/share/emacs/site-lisp/subdirs.el \
        /usr/local/share/glib-2.0/schemas/org.gnu.emacs.defaults.gschema.xml
    sudo rmdir --ignore-fail-on-non-empty /usr/local/share/emacs/site-lisp /usr/local/share/emacs 2>/dev/null || true

    local schemas=/usr/local/share/glib-2.0/schemas
    if compgen -G "${schemas}/*.xml" >/dev/null; then
        sudo glib-compile-schemas "${schemas}"
    else
        sudo rm -f "${schemas}/gschemas.compiled"
    fi
}

echo "Installing ${EMACS_PKG} from emacs-builds ${EMACS_RELEASE}"
install_deb "${EMACS_DEB_URL}" "${EMACS_PKG}"
remove_old_source_build

hash -r
emacs --version | head -1
