#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:
set -euo pipefail

# if arch based system
# {{- if eq .archlinux true }}
# pacman.conf tweaks: Color, VerbosePkgLists, ParallelDownloads=5, ILoveCandy, and
# the [multilib] repo (steam, lib32-nvidia-utils). Idempotent, so a fresh install no
# longer has to hand-edit the file before the first apply.
PACMAN_CONF=/etc/pacman.conf
if ! grep -q "^ILoveCandy" "$PACMAN_CONF" || ! grep -q "^\[multilib\]" "$PACMAN_CONF"; then
    echo "Configuring $PACMAN_CONF..."
    sudo cp -n "$PACMAN_CONF" "${PACMAN_CONF}.backup"
    sudo sed -i -E \
        -e 's/^#(Color|VerbosePkgLists)$/\1/' \
        -e 's/^#?ParallelDownloads.*/ParallelDownloads = 5/' \
        "$PACMAN_CONF"
    grep -q "^ILoveCandy" "$PACMAN_CONF" ||
        sudo sed -i 's/^ParallelDownloads = 5$/&\nILoveCandy/' "$PACMAN_CONF"
    # uncomment the [multilib] header and the Include line right after it
    sudo sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//}' "$PACMAN_CONF"
fi

sudo pacman -Syu --noconfirm
sudo pacman -S --noconfirm --needed base-devel archlinux-keyring findutils git curl wget unzip

if command -v yay 2>/dev/null; then
    echo "Yay is already installed. Skipping..."
else
    echo "Installing Yay..."
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    cd /tmp/yay
    makepkg -si --noconfirm 2>&1 || { printf "Failed to install"; exit 1; }
fi

# {{ template "scripts/download_helpers.sh" . }}
# {{ template "scripts/service_helpers.sh" . }}
# {{ template "scripts/gpu_helpers.sh" . }}

packages=(
    # Hyperland and Wayland
    cliphist
    flameshot
    gnome-keyring
    grim
    hypridle
    hyprland
    hyprlock
    hyprpaper
    hyprpicker
    hyprpolkitagent
    hyprshot
    imagemagick
    kvantum-qt5
    libsecret
    qt5-wayland
    qt6-wayland
    qt6ct
    rofi
    slurp
    swappy
    libnotify
    swaync
    uwsm
    xdg-desktop-portal-gtk
    xdg-desktop-portal-hyprland
    
    # Audio
    pipewire
    pipewire-alsa
    pipewire-audio
    pipewire-pulse
    sof-firmware
    wireplumber

    # Audio enhancement and control
    easyeffects
    lsp-plugins
    pavucontrol

    # Basics
    btop
    chezmoi
    fontconfig
    htop
    inotify-tools
    less
    man
    man-db
    man-pages
    openssh
    pciutils
    libfido2
    pacman-contrib
    pam-u2f
    plocate
    tmux
    unzip
    wl-clipboard
    xdg-user-dirs
    xdg-utils
    zip
    zsh
    zsh-completions

    # Display manager (themed by run_onchange_after_83_install-arch-sddm-theme)
    sddm

    # Networking and Bluetooth
    bluez
    bluez-utils
    blueman
    iwd
    net-tools
    network-manager-applet
    networkmanager
    networkmanager-dmenu
    wireless-regdb

    # File Manager
    ffmpegthumbnailer 
    gvfs
    gvfs-afc
    gvfs-dnssd
    gvfs-mtp
    gvfs-smb
    gvfs-wsdd
    thunar 
    thunar-archive-plugin
    thunar-media-tags-plugin
    thunar-volman 
    tumbler
    xarchiver

    # Printer and discovery
    avahi
    cups
    cups-pdf
    nss-mdns
)
aur_pkgs=(
    tumbler-stl-thumbnailer
    # Hyperland and Wayland
    # waybar 0.15.0 (repo) can't click workspaces or track windows on Lua-config
    # Hyprland >= 0.55 (fixed upstream after 0.15.0). Swap back to repo `waybar`
    # once a release > 0.15.0 lands. First switch needs a manual `yay -S waybar-git`
    # (it replaces waybar; --noconfirm declines that removal).
    waybar-git
    wlogout
)
# NVIDIA userspace. The Wayland/VA-API bits only when NVIDIA drives the display --
# Hyprland will not start on NVIDIA without them; compute-only cards (display on the
# iGPU) just need the driver + CUDA. The kernel module is handled by the 13_ script.
case "$(nvidia_gpu_mode)" in
    display) packages+=(nvidia-utils egl-wayland libva-nvidia-driver) ;;
    compute) packages+=(nvidia-utils) ;;
esac

# Intel/AMD GPUs: Mesa (OpenGL) comes with hyprland; add Vulkan + VA-API video decode.
for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "$dev/class" 2>/dev/null)" == 0x03* ]] || continue
    case "$(cat "$dev/vendor" 2>/dev/null)" in
        0x8086) packages+=(vulkan-intel intel-media-driver) ;;
        0x1002) packages+=(vulkan-radeon) ;;
    esac
done

install_packages_from_arrays

# Actiona to take before starting serviecs
#
# Disable multicast dns in resolved. Avahi will provide this for better network printer discovery
sudo mkdir -p /etc/systemd/resolved.conf.d
echo -e "[Resolve]\nMulticastDNS=no" | sudo tee /etc/systemd/resolved.conf.d/10-disable-multicast.conf
# Enable automatically adding remote printers
if ! grep -q '^CreateRemotePrinters Yes' /etc/cups/cups-browsed.conf; then
  echo 'CreateRemotePrinters Yes' | sudo tee -a /etc/cups/cups-browsed.conf
fi


system_services=(
    avahi-daemon.service
    cups.service
    sshd
    NetworkManager.service
    bluetooth.service
)
user_services=(
    hypridle.service
    hyprpolkitagent.service
    pipewire-pulse.socket
    pipewire.service
    pipewire.socket
    wireplumber.service
)

enable_services_from_arrays

# Enable (but don't start) the display manager -- starting it mid-apply would grab the
# console out from under this script. It takes over on the next boot.
sudo systemctl enable sddm.service

# Check if the 'input' group exists
if grep -q '^input:' /etc/group; then
    echo "input group exists."
else
    echo "input group doesn't exist. Creating input group..."
    sudo groupadd input
fi

# Add the user to the 'input' group
sudo usermod -aG input "$(whoami)"

echo "Make Thunar default file manager"
xdg-mime default thunar.desktop inode/directory
xdg-mime default thunar.desktop application/x-wayland-gnome-saved-search

# some variable
echo "local bin directory setup"
LOCALBIN=$HOME/.local/bin
[ -d "$LOCALBIN" ] || mkdir -p "$LOCALBIN"

echo "set ZSH to default"
zsh=$(which zsh)
if [ "$SHELL" != "$zsh" ]; then
    sudo chsh -s "$zsh" "$(whoami)"
fi

sudo sysctl fs.inotify.max_user_watches=100000
sudo sysctl fs.inotify.max_queued_events=100000

# Disable USB autosuspend to prevent peripheral disconnection issues.
#
# usbcore is built into the Arch kernel (`modinfo usbcore` -> "filename: (builtin)"), so
# /etc/modprobe.d/ is never consulted for it -- the old drop-in here was dead code and
# /sys/module/usbcore/parameters/autosuspend stayed at the 2s default. Built-in modules
# only take parameters from the kernel command line.
if [[ -f /etc/modprobe.d/disable-usb-autosuspend.conf ]]; then
  echo "Removing ineffective usbcore modprobe drop-in (usbcore is builtin)..."
  sudo rm -f /etc/modprobe.d/disable-usb-autosuspend.conf
fi

{{ if eq .chassisType "desktop" -}}
# DESKTOP ONLY: this disables runtime power management for *every* USB device, which is
# a meaningful battery cost on a laptop. Mains-powered machines only.
# Skipped automatically on systemd-boot machines (no /etc/default/grub).
USB_PARAM="usbcore.autosuspend=-1"
GRUB_DEFAULT_CONF="/etc/default/grub"
if [[ -f $GRUB_DEFAULT_CONF ]] && ! grep -q "$USB_PARAM" "$GRUB_DEFAULT_CONF"; then
  echo "Adding $USB_PARAM to the kernel command line..."
  sudo cp -n "$GRUB_DEFAULT_CONF" "${GRUB_DEFAULT_CONF}.backup"
  sudo sed -i -E "s|^(GRUB_CMDLINE_LINUX=\")(.*)(\")|\1\2 $USB_PARAM\3|" "$GRUB_DEFAULT_CONF"
  # Collapse any leading/double spaces the substitution may have introduced.
  sudo sed -i -E 's|^(GRUB_CMDLINE_LINUX=")\s+|\1|; s|(GRUB_CMDLINE_LINUX="[^"]*)  +|\1 |g' "$GRUB_DEFAULT_CONF"
  echo "Regenerating grub.cfg (takes effect on next boot)..."
  sudo grub-mkconfig -o /boot/grub/grub.cfg
fi
{{ end -}}

# {{- end }}
