#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:
set -euo pipefail

# Install the "lumen" SDDM theme (hyprlock look-alike, colored from .colorScheme).
# Re-runs whenever the theme, palette or current wallpaper changes:
# wallpaper: {{ output "readlink" "-f" (joinPath .chezmoi.homeDir ".cache/wallpapers/wall.current") | trim }}

if ! pacman -Q sddm &> /dev/null; then
    echo "SDDM not installed. Skipping theme setup."
    exit 0
fi

THEME_NAME=lumen
THEME_DIR=/usr/share/sddm/themes/$THEME_NAME
WALLPAPER="$HOME/.cache/wallpapers/wall.current"
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

cat > "$STAGE/metadata.desktop" << 'THEME'
[SddmGreeterTheme]
Name=Lumen
Description=Minimal theme matching hyprlock, generated by chezmoi
Type=sddm-theme
Version=1.0
MainScript=Main.qml
ConfigFile=theme.conf
Theme-Id=lumen
Theme-API=2.0
QtVersion=6
THEME

cat > "$STAGE/theme.conf" << 'THEME'
{{ includeTemplate "sddm/theme.conf" . }}
THEME

cat > "$STAGE/Main.qml" << 'THEME'
{{ includeTemplate "sddm/Main.qml" . }}
THEME

# SDDM runs as its own user and cannot read $HOME, so ship a copy of the wallpaper.
if [[ -e "$WALLPAPER" ]]; then
    magick "$WALLPAPER" -resize '2560x2560>' -quality 90 "$STAGE/background.jpg" ||
        cp -L "$WALLPAPER" "$STAGE/background.jpg"
fi

sudo rm -rf "$THEME_DIR"
sudo install -d -m 755 "$THEME_DIR"
sudo install -m 644 "$STAGE"/* "$THEME_DIR"/

sudo install -d -m 755 /etc/sddm.conf.d
sudo tee /etc/sddm.conf.d/10-theme.conf > /dev/null << CONF
[Theme]
Current=$THEME_NAME
Font={{ .font.regular }}
CONF

echo "SDDM theme '$THEME_NAME' installed to $THEME_DIR"
