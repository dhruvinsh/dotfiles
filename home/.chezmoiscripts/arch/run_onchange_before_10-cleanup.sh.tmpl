#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:

# if arch based system
# {{- if eq .archlinux true }}

echo "Removing direnv package..."
[ "$(command -v direnv)" ] && sudo pacman -Rns --noconfirm direnv || echo "done"

echo "Removing neovim package..."
if pacman -Qq neovim &>/dev/null; then
    sudo pacman -Rns --noconfirm neovim
fi

echo "Removing packages: mise migrated..."
sudo pacman -Rns --noconfirm glow gitleaks
# separate + guarded: pacman aborts the whole removal if any target is missing
if pacman -Qq starship &>/dev/null; then
    sudo pacman -Rns --noconfirm starship
fi

# {{- end }}
