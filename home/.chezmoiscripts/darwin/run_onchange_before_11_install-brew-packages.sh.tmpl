#!/usr/bin/env bash
set -euo pipefail

# brew package
packages=(
    bat
    bat-extras
    chafa
    editorconfig
    eza
    fd
    fzf
    git # Apple's Xcode git lags; config uses zdiff3, hasconfig, updateRefs (git >= 2.38)
    gnu-sed
    helix
    hyperfine
    jq
    kopiaui
    lazydocker
    lazygit
    luarocks
    mas
    ranger
    rclone
    ripgrep
    sevenzip
    tealdeer
    tmux
    tree
    wget
    yq
    zoxide
)

# some measureing tools
packages+=(
    btop
    htop
)

# pyenv dependency
packages+=(
    openssl
    readline
    sqlite3
    xz
    zlib
    tcl-tk
)

# some cask packages
casks=(
    font-maple-mono-nf
    ghostty
    iina
    kitty
    nextcloud
    obsidian
    syncthing
    visual-studio-code
    wezterm
)

############################
# Installation starts here #
############################

# install all the packages
brew install "${packages[@]}"
brew install --cask "${casks[@]}"

