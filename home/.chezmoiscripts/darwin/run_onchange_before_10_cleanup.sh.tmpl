#!/usr/bin/env bash
# vim: set expandtab ft=bash ts=4 tw=4:

echo "Removing direnv package..."
brew uninstall --force direnv

echo "Removing selene and shellcheck packages..."
brew uninstall --force selene shellcheck

echo "Removing neovim package..."
brew uninstall --force neovim

echo "Removing mise package (brew)..."
brew uninstall --force mise 2> /dev/null || true

echo "Removing git/md related tools..."
brew uninstall --force gh git-cliff gitleaks glow 2> /dev/null || true

echo "Removing starship package (mise migrated)..."
brew uninstall --force starship 2> /dev/null || true

echo "Removing atuin package (mise migrated)..."
brew uninstall --force atuin 2> /dev/null || true

echo "Removing ast-grep package (mise migrated)..."
brew uninstall --force ast-grep 2> /dev/null || true

echo "Removing diffr package (mise migrated)..."
brew uninstall --force diffr 2> /dev/null || true

echo "Removing just package (mise migrated)..."
brew uninstall --force just 2> /dev/null || true

echo "Removing television package (mise migrated)..."
brew uninstall --force television 2> /dev/null || true

echo "Removing kitty and wezterm (ghostty only)..."
brew uninstall --cask --force kitty wezterm 2> /dev/null || true

exit 0
