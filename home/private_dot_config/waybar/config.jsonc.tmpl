{
  "name": "waybar",
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces", "hyprland/window", "group/music"],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "systemd-failed-units",
    "custom/updates",
    "group/systray",
    "group/hw",
    "group/audio",
    "pulseaudio#mic",
    "network",
    "bluetooth",
    "idle_inhibitor",
    "custom/notification",
    "custom/power",
  ],

  // ---------------------------------------------------------------- left
  "hyprland/workspaces": {
    // workspace number, then one icon per window (e.g. "3  󰖟 ")
    "format": "<b>{id}</b> {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<com.mitchellh.ghostty>": "",
      "class<ghostty>": "",
      "class<kitty>": "󰄛",
      "class<Alacritty>": "",
      "class<firefox>": "󰈹",
      "class<brave-browser>": "󰖟",
      "class<Brave-browser>": "󰖟",
      "class<chromium>": "",
      "class<google-chrome>": "",
      "class<com.microsoft.VSCode>": "󰨞",
      "class<code>": "󰨞",
      "class<Code>": "󰨞",
      "class<code-url-handler>": "󰨞",
      "class<thunar>": "󰉋",
      "class<Thunar>": "󰉋",
      "class<org.gnome.Nautilus>": "󰉋",
      "class<discord>": "󰙯",
      "class<vesktop>": "󰙯",
      "class<spotify>": "",
      "class<Spotify>": "",
      "class<mpv>": "",
      "class<vlc>": "󰕼",
      "class<obsidian>": "󱓧",
      "class<steam>": "",
      "class<org.telegram.desktop>": "",
      "class<emacs>": "",
      "class<Emacs>": "",
      "class<pavucontrol>": "󰕾",
      "class<org.pulseaudio.pavucontrol>": "󰕾",
      "class<blueman-manager>": "󰂯",
      "class<dev.ds.floating>": "",
    },
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - Mozilla Firefox": "󰈹 $1",
      "(.*) - Brave": "󰖟 $1",
      "(.*) - Google Chrome": " $1",
      "(.*) - Visual Studio Code": "󰨞 $1",
      "(.*) - Obsidian.*": "󱓧 $1",
      "(.*) - Thunar": "󰉋 $1",
      "(.*) - mpv": " $1",
      "^$": "",
    },
  },
  "group/music": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "music-child",
      "transition-left-to-right": true,
      "click-to-reveal": false,
    },
    "modules": ["mpris", "custom/prev", "custom/next"],
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 40,
    "player-icons": {
      "default": "▶",
      "mpv": "",
      "spotify": "",
      "firefox": "󰈹",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "ignored-players": ["firefox"],
    "max-length": 50,
    "tooltip-format": "{player}: {artist} - {title}\n{album}",
    "tooltip-format-paused": "{player} (paused): {artist} - {title}\n{album}",
  },
  "custom/prev": {
    "format": "󰒮",
    "on-click": "playerctl previous",
    "tooltip": false,
  },
  "custom/next": {
    "format": "󰒭",
    "on-click": "playerctl next",
    "tooltip": false,
  },

  // -------------------------------------------------------------- center
  "clock": {
    "format": "  {:%I:%M %p}",
    "format-alt": "  {:%a, %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='{{ .colorScheme.mauve }}'><b>{}</b></span>",
        "days": "<span color='{{ .colorScheme.text }}'>{}</span>",
        "weeks": "<span color='{{ .colorScheme.overlay1 }}'><i>W{}</i></span>",
        "weekdays": "<span color='{{ .colorScheme.blue }}'><b>{}</b></span>",
        "today": "<span color='{{ .colorScheme.red }}'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_reset",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up",
    },
  },

  // --------------------------------------------------------------- right
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 },
    ],
  },
  "systemd-failed-units": {
    "hide-on-ok": true,
    "format": "󰀦 {nr_failed}",
    "format-ok": "",
    "system": true,
    "user": true,
  },
  "custom/updates": {
    "exec": "~/.local/bin/waybar-updates.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 8,
    "format": "{}",
    "hide-empty-text": true,
    "on-click": "ghostty --class=dev.ds.floating -e yay -Syu; pkill -RTMIN+8 waybar",
  },
  // id "systray": a group named "tray" would share #tray with the tray module
  "group/systray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "tray-child",
      "transition-left-to-right": false,
      "click-to-reveal": true,
    },
    "modules": ["custom/tray-arrow", "tray"],
  },
  "custom/tray-arrow": {
    "format": "󰅁",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },
  "group/hw": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "hw-child",
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
    "modules": ["cpu", "memory", "temperature"],
  },
  "cpu": {
    "interval": 2,
    "format": "{icon} {usage}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": {
      "warning": 70,
      "critical": 90,
    },
    "tooltip-format": "CPU {usage}%",
    "on-click": "ghostty --class=dev.ds.floating -e btop",
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "states": {
      "warning": 70,
      "critical": 90,
    },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 75,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°C",
    "format-warning": "{icon} {temperatureC}°C",
    "format-critical": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "CPU Tctl {temperatureC}°C",
  },
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "audio-child",
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-bluetooth": "{icon}󰂯 {volume}%",
    "format-bluetooth-muted": "󰝟󰂯 muted",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "hands-free": "󰋎",
      "speaker": "󰓃",
      "hdmi": "󰡁",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "tooltip-format": "{desc}\nVolume: {volume}%",
    "max-volume": 100,
    "scroll-step": 5,
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-click-right": "pavucontrol",
    "on-click-middle": "~/.local/bin/audio-switch.sh",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "tooltip-format": "Microphone: {source_desc}\nVolume: {source_volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol --tab=4",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "format-linked": "󰈀 (no IP)",
    "tooltip-format-wifi": "{icon} {essid} ({signalStrength}%)\n{ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}/{cidr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "networkmanager_dmenu",
    "on-click-right": "ghostty --class=dev.ds.floating -e nmtui",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪",
    },
    "tooltip-format-activated": "Idle inhibitor: on",
    "tooltip-format-deactivated": "Idle inhibitor: off",
  },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "escape": true,
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
  },
  "custom/power": {
    "format": "󰤆",
    "tooltip": false,
    "on-click": "~/.local/bin/__wlogout.sh",
  },
}
