// Bar layouts only; look and module settings come from common.jsonc.
{{- if not .personalmachine }}
// Work PC: full bar everywhere except the left screen, which gets a minimal one.
[
{{- end }}
{
  "include": ["~/.config/waybar/common.jsonc"],
  {{- if not .personalmachine }}
  "output": "!{{ .workMonitors.left }}",
  {{- end }}
  "modules-left": ["hyprland/workspaces", "hyprland/window", "custom/media"],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "systemd-failed-units",
    "custom/updates",
    "group/systray",
    "group/hw",
    "group/audio",
    "pulseaudio#mic",
    "network",
    "bluetooth",
    "idle_inhibitor",
    "custom/notification",
    "custom/power",
  ],
}
{{- if not .personalmachine }},
{
  "include": ["~/.config/waybar/common.jsonc"],
  "output": "{{ .workMonitors.left }}",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/audio", "pulseaudio#mic"],
},
]
{{- end }}
