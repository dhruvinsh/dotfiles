{{ includeTemplate "gtk-colors.css" . }}

* {
  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: "{{ .font.regular }}";
  font-size: 13px;
}

window#waybar {
  background: transparent;
  color: @text;
}

tooltip {
  background: alpha(@base, 0.95);
  border: 1px solid alpha(@surface2, 0.8);
  border-radius: 12px;
}

tooltip label {
  color: @text;
  padding: 2px 4px;
}

/* ---- island pills ---- */
#workspaces,
#window,
#music,
#clock,
#privacy,
#systemd-failed-units,
#custom-updates,
#systray,
#hw,
#audio,
#pulseaudio.mic,
#network,
#bluetooth,
#idle_inhibitor,
#custom-notification,
#custom-power {
  background: alpha(@base, 0.80);
  border: 1px solid alpha(@surface2, 0.6);
  border-radius: 14px;
  padding: 0 12px;
  margin: 0;
  color: @text;
}

/* groups: inner modules carry no extra chrome */
#music > *,
#systray > *,
#hw > *,
#audio > * {
  background: transparent;
  border: none;
  padding: 0;
}

#window {
  color: @subtext1;
}

window#waybar.empty #window {
  background: transparent;
  border-color: transparent;
  padding: 0;
}

/* ---- workspaces ---- */
#workspaces {
  padding: 0 4px;
}

/* Only workspace pills animate; a global transition made every label fade
   out/in whenever its text changed (window title, mpris). */
#workspaces button {
  transition: all 0.25s cubic-bezier(.4, 0, .2, 1);
  padding: 0 10px;
  margin: 3px 2px;
  border-radius: 11px;
  color: @subtext0;
  background: transparent;
  box-shadow: none;
  text-shadow: none;
}

#workspaces button:hover {
  background: alpha(@surface1, 0.8);
  color: @text;
}

#workspaces button.active {
  padding: 0 18px;
  color: @crust;
  font-weight: bold;
  background: linear-gradient(135deg, @accent, @accent2);
}

#workspaces button.urgent {
  background: @red;
  color: @crust;
}

#workspaces button.empty {
  color: @overlay0;
}

/* ---- music ---- */
#mpris {
  color: @green;
}

#mpris.paused {
  color: @overlay1;
}

#custom-prev,
#custom-next {
  color: @subtext0;
  padding-left: 8px;
}

#custom-prev:hover,
#custom-next:hover {
  color: @accent;
}

/* ---- center ---- */
#clock {
  color: @text;
  font-weight: bold;
  padding: 0 18px;
}

#clock:hover {
  background: alpha(@surface0, 0.9);
  border-color: alpha(@accent, 0.7);
}

/* ---- right modules ---- */
#privacy {
  color: @peach;
}

#systemd-failed-units {
  color: @red;
}

#custom-updates {
  color: @yellow;
}

#custom-updates.many {
  color: @peach;
}

#custom-updates.none {
  padding: 0;
  border-color: transparent;
  background: transparent;
}

#custom-tray-arrow {
  color: @accent;
  font-size: 15px;
  padding: 0 2px;
}

#systray:hover #custom-tray-arrow {
  color: @text;
}

#tray {
  padding-left: 8px;
}

#tray > .passive {
  -gtk-icon-effect: dim;
}

#tray > .needs-attention {
  -gtk-icon-effect: highlight;
}

#cpu {
  color: @sapphire;
  padding-right: 10px;
}

#memory {
  color: @mauve;
  padding-right: 10px;
}

#temperature {
  color: @green;
}

#cpu.warning,
#memory.warning,
#temperature.warning {
  color: @yellow;
}

#cpu.critical,
#memory.critical,
#temperature.critical {
  color: @red;
  animation: pulse 1.2s ease-in-out infinite alternate;
}

#pulseaudio {
  color: @blue;
}

#pulseaudio.muted {
  color: @overlay1;
}

#pulseaudio.mic {
  color: @teal;
}

#pulseaudio.mic.source-muted {
  color: @red;
}

#pulseaudio-slider {
  padding-left: 10px;
}

#pulseaudio-slider slider {
  min-height: 0;
  min-width: 0;
  opacity: 0;
  background: transparent;
  box-shadow: none;
}

#pulseaudio-slider trough {
  min-height: 6px;
  min-width: 90px;
  border-radius: 3px;
  background: alpha(@surface2, 0.7);
}

#pulseaudio-slider highlight {
  min-height: 6px;
  border-radius: 3px;
  background: linear-gradient(90deg, @accent2, @accent);
}

#network {
  color: @sky;
}

#network.disconnected,
#network.disabled {
  color: @red;
}

#bluetooth {
  color: @blue;
}

#bluetooth.connected {
  color: @accent;
}

#bluetooth.off,
#bluetooth.disabled {
  color: @overlay1;
}

#idle_inhibitor {
  color: @subtext0;
}

#idle_inhibitor.activated {
  color: @yellow;
}

#custom-notification {
  color: @text;
}

#custom-notification.notification {
  color: @peach;
}

#custom-notification.dnd-none,
#custom-notification.dnd-notification {
  color: @overlay1;
}

#custom-power {
  color: @red;
  padding: 0 14px;
}

/* ---- hover ---- */
#window:hover,
#music:hover,
#privacy:hover,
#custom-updates:hover,
#systray:hover,
#hw:hover,
#audio:hover,
#pulseaudio.mic:hover,
#network:hover,
#bluetooth:hover,
#idle_inhibitor:hover,
#custom-notification:hover,
#systemd-failed-units:hover {
  background: alpha(@surface0, 0.9);
  border-color: alpha(@accent, 0.6);
}

#custom-power:hover {
  background: @red;
  color: @crust;
  border-color: @red;
}

/* ---- critical pulse ---- */
@keyframes pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.55;
  }
}
