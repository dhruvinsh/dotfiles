{{ includeTemplate "gtk-colors.css" . }}

* {
    font-family: "{{ .font.regular }}";
    font-size: 13pt;
    font-weight: bold;
}

/* Full-screen layer (namespace: logout_dialog); Hyprland layerrule adds the blur. */
window {
    background-color: alpha(@crust, 0.55);
    color: @text;
}

button {
    color: @subtext1;
    background-color: alpha(@surface0, 0.75);
    background-repeat: no-repeat;
    background-position: center 14%;
    background-size: 34%;
    border: 2px solid alpha(@surface2, 0.6);
    border-radius: 24px;
    box-shadow: none;
    text-shadow: none;
    outline-style: none;
    transition: all 0.25s cubic-bezier(.25, .8, .25, 1);
}

button:focus,
button:hover {
    background-color: @accent;
    border-color: @accent;
    color: @crust;
    background-size: 40%;
    box-shadow: 0 8px 32px alpha(@crust, 0.6);
}

#lock       { background-image: image(url("./icons/lock.png")); }
#logout     { background-image: image(url("./icons/logout.png")); }
#suspend    { background-image: image(url("./icons/sleep.png")); }
#reboot     { background-image: image(url("./icons/restart.png")); }
#shutdown   { background-image: image(url("./icons/power.png")); }

#lock:hover,   #lock:focus   { background-image: image(url("./icons/lock-hover.png")); }
#logout:hover, #logout:focus { background-image: image(url("./icons/logout-hover.png")); }
#suspend:hover, #suspend:focus { background-image: image(url("./icons/sleep-hover.png")); }
#reboot:hover, #reboot:focus { background-image: image(url("./icons/restart-hover.png")); }
#shutdown:hover, #shutdown:focus { background-image: image(url("./icons/power-hover.png")); }

#logout:hover,  #logout:focus  { background-color: @accent2; border-color: @accent2; }
#reboot:hover,  #reboot:focus  { background-color: @peach; border-color: @peach; }
#shutdown:hover, #shutdown:focus { background-color: @red; border-color: @red; }
