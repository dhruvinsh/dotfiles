-------------------
---- AUTOSTART ----
-------------------

-- See https://wiki.hypr.land/Configuring/Basics/Autostart/
-- exec-once equivalents: run once when Hyprland starts.

hl.on("hyprland.start", function()
  -- uwsm does not export UWSM_ACTIVE; detect it via the vars it sets for the compositor.
  local uwsm = os.getenv("UWSM_FINALIZE_VARNAMES") ~= nil or os.getenv("UWSM_ACTIVE") ~= nil

  local function run(cmd)
    if uwsm then
      -- Remove trailing & if present since systemd handles execution context
      local clean = cmd:gsub("%s*&$", "")
      hl.exec_cmd("uwsm app -- " .. clean .. " &")
    else
      hl.exec_cmd(cmd)
    end
  end

  -- NOTE: don't probe with os.execute() here -- Hyprland reaps children itself, so
  -- os.execute always returns (nil, "No child processes"). io.open is safe.
  local function file_exists(path)
    local f = io.open(path, "r")
    if f then
      f:close()
    end
    return f ~= nil
  end

  -- night light
  run("hyprsunset &")

  -- clipboard history
  run("wl-paste --type text --watch cliphist store")
  run("wl-paste --type image --watch cliphist store")

  -- USB automounting (with system tray support)
  run("udiskie &")

  -- appearance: cursor (directly in compositor)
  hl.exec_cmd("hyprctl setcursor Bibata-Modern-Classic 24")

  -- GUI light/dark mode (GTK3/4 theme, icons, portal color-scheme); the mode
  -- persists in dconf, this re-syncs the themes with it. Toggle: swaync button.
  hl.exec_cmd("~/.local/bin/theme-mode apply")

  -- appearance: top bar, wallpaper
  run("waybar &")

  -- wallpaper-manager persists the current wallpaper as a hyprpaper config, so
  -- hyprpaper paints it on the first frame (no default-wallpaper flash). The
  -- restore call is a fallback for first boot; it retries until hyprpaper answers.
  local wall_conf = os.getenv("HOME") .. "/.cache/wallpapers/hyprpaper.conf"
  if file_exists(wall_conf) then
    run("hyprpaper -c " .. wall_conf .. " &")
  else
    run("hyprpaper &")
  end
  hl.exec_cmd("~/.local/bin/wallpaper-manager restore")

  -- authentication agent (already systemd managed user service)
  hl.exec_cmd("systemctl --user start hyprpolkitagent.service")

  -- swayosd volume/brightness listener daemon
  run("swayosd-server &")

  -- screenshot daemon (flameshot); SUPER+SHIFT+S -> flameshot gui
  run("flameshot &")
  -- {{ if not .personalmachine }}

  -- Work PC: Outlook (Brave PWA) and Teams side by side on workspace 8 (left
  -- screen); window rules in hyprland.lua send them there. They map in whatever
  -- order they finish starting, so once both are up make sure Outlook is on the left.
  local outlook = "brave-faolnafnngnfdaknnbpnkhgohbobgegn-Default"
  local teams = "teams-for-linux"
  local function find(class)
    for _, w in ipairs(hl.get_workspace_windows(8)) do
      if w.class == class then
        return w
      end
    end
  end
  local sub
  sub = hl.on("window.open", function()
    if not (find(outlook) and find(teams)) then
      return
    end
    sub:remove()
    -- let the layout settle before reading positions
    hl.timer(function()
      local o, t = find(outlook), find(teams)
      if o and t and t.at.x < o.at.x then
        hl.dispatch(hl.dsp.window.swap({ window = t, with = o }))
      end
    end, { timeout = 500, type = "oneshot" })
  end)
  run("brave --profile-directory=Default --app-id=faolnafnngnfdaknnbpnkhgohbobgegn &")
  run("teams-for-linux &")
  -- {{ end }}
end)
