general {
    hide_cursor = true
    ignore_empty_input = true
}

background {
    monitor =
    path = ~/.cache/wallpapers/wall.current
    blur_passes = 3
    blur_size = 6
    noise = 0.02
    brightness = 0.7
    vibrancy = 0.2
}

# Everything else -- clock, date, the depth-effect cutout, greeting, password,
# quote, now playing -- lives in hyprlock-depth.conf: wallpaper-manager rewrites
# it on every wallpaper change so the layout follows the clock and its colours
# follow the wallpaper. chezmoi only seeds it (create_hyprlock-depth.conf.tmpl).
source = {{ .chezmoi.homeDir }}/.config/hypr/hyprlock-depth.conf
