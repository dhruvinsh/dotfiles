# vim: set ft=sh:

# Core Cursor Settings
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# Toolkit / Qt Configuration
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=qt6ct

# XDG Specifications
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# NVIDIA Configuration -- only when NVIDIA drives the display (not compute-only cards)
{{ if eq (includeTemplate "nvidia-mode" .) "display" -}}
export GBM_BACKEND=nvidia-drm
export LIBVA_DRIVER_NAME=nvidia
export NVD_BACKEND=direct
export __GLX_VENDOR_LIBRARY_NAME=nvidia
{{ end -}}

# GTK4 >= 4.24 attaches ext-background-effect to every window with an empty
# blur region, which makes Hyprland skip its blur for it (ghostty, nautilus...)
export GDK_WAYLAND_DISABLE=ext_background_effect_manager_v1

# Electron / CEF Hardware Acceleration
export ELECTRON_OZONE_PLATFORM_HINT=auto
