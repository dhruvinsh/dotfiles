#
# chezmoi picks the shebang: a uv script where uv is installed (mise; uwsm/env puts
# it on the session PATH), else plain python3 >= 3.10 -- stdlib only, so a fresh
# machine without uv still gets wallpapers.
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///

"""Wallpaper manager for Hyprland (Quickshell or hyprpaper) and i3/feh.

Keeps the cache layout other configs rely on (rofi, hyprlock, sddm):
~/.cache/wallpapers/{current.txt,thumbs/,wall.current,wall.thmb,wall.blur,hyprpaper.conf}
and adds state.json, watched by the Quickshell wallpaper (depth effect).
"""

import argparse
import colorsys
import hashlib
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
WALLPAPER_DIR = Path(os.environ.get("WALLPAPER_DIR", HOME / "Pictures/wallpapers"))
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "wallpapers"
THUMB_DIR = CACHE_DIR / "thumbs"
DEPTH_DIR = CACHE_DIR / "depth"
CURRENT_WALL = CACHE_DIR / "current.txt"
STATE_FILE = CACHE_DIR / "state.json"
HYPRPAPER_CONF = CACHE_DIR / "hyprpaper.conf"
DEPTH_TOOL = HOME / ".local/bin/wallpaper-depth"
NO_UV_FLAG = CACHE_DIR / ".no-uv-notified"
# clock positions you dragged in the picker: user choices, so state, not cache
CLOCK_OVERRIDES = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "wallpaper-manager/clock.json"
THUMBNAIL_SIZE = 500
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp"}
ROFI_FONT = "{{ .font.regular }} 10"
CLOCK_FONT, DATE_FONT = "{{ .font.regular }} ExtraBold", "{{ .font.italic }} Italic"
LABEL_FONT, QUOTE_FONT = "{{ .font.regular }}", "{{ .font.italic }}"
# hyprlock.conf sources this: clock + cutout for the current wallpaper
LOCK_CONF = HOME / ".config/hypr/hyprlock-depth.conf"
LOCK_FG = CACHE_DIR / "lock-fg.png"
LOCK_BRIGHTNESS = 0.7  # hyprlock.conf's background brightness, so the cutout matches


def notify(title, body=""):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "wallpaper", title, body], check=False)
    else:
        print(f"{title}: {body}", file=sys.stderr)


def die(msg):
    notify("Wallpaper Error", msg)
    sys.exit(1)


def get_hash(path):
    # sha256 of the path string, same as the old bash `echo -n | sha256sum`
    return hashlib.sha256(str(path).encode()).hexdigest()


def natural_key(path):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", path.name)]


def list_wallpapers():
    if not WALLPAPER_DIR.is_dir():
        die(f"Wallpaper directory not found: {WALLPAPER_DIR}")
    # resolved like set/depth do, so hashes and current-wallpaper checks match
    walls = [p.resolve() for p in WALLPAPER_DIR.rglob("*") if p.is_file() and p.suffix.lower() in IMAGE_EXTS]
    if not walls:
        die(f"No wallpapers found in {WALLPAPER_DIR}")
    return sorted(walls, key=natural_key)


def current_wallpaper():
    try:
        return Path(CURRENT_WALL.read_text().strip())
    except OSError:
        return None


def image_cmd():
    for cmd in ("magick", "convert"):
        if shutil.which(cmd):
            return cmd
    return None


def generate_cache(wall):
    """Create the rofi thumbnail and blurred background; return the thumbnail path."""
    h = get_hash(wall)
    thumb, blur = THUMB_DIR / f"{h}.thumb", THUMB_DIR / f"{h}.blur"
    cmd = image_cmd()
    if cmd is None:
        print("Error: Neither 'magick' nor 'convert' found.", file=sys.stderr)
        return thumb
    size = f"{THUMBNAIL_SIZE}x{THUMBNAIL_SIZE}"
    if not thumb.exists():
        subprocess.run(
            [cmd, str(wall), "-strip", "-thumbnail", f"{size}^", "-gravity", "center", "-extent", size, f"png:{thumb}"],
            stderr=subprocess.DEVNULL,
            check=False,
        )
    if not blur.exists():
        subprocess.run(
            [cmd, str(wall), "-strip", "-scale", "10%", "-blur", "0x3", "-resize", "100%", f"png:{blur}"],
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return thumb


def depth_path(wall):
    return DEPTH_DIR / f"{get_hash(wall)}.png"


# --- clock colours from the wallpaper -------------------------------------------

DEFAULT_CLOCK = (0.5, 0.08)  # centre x, top y in screen fractions (Clock.qml)


def clock_region(cx, cy):
    """Screen-fraction box (x, y, w, h) around a clock centred at cx, top at cy;
    matches Clock.qml's size. Keep in sync with wallpaper-depth."""
    x, y = min(max(cx - 0.2, 0), 0.6), min(max(cy - 0.02, 0), 0.64)
    return (x, y, 0.4, 0.36)


def region_in_image(region, img_aspect, screen_aspect):
    """Map a clock region given in screen fractions to image fractions: the
    wallpaper is shown centred with cover-crop (Image.PreserveAspectCrop)."""
    x, y, w, h = region
    if img_aspect > screen_aspect:  # wider image: sides cropped
        visible = screen_aspect / img_aspect
        return ((1 - visible) / 2 + x * visible, y, w * visible, h)
    visible = img_aspect / screen_aspect  # taller image: top/bottom cropped
    return (x, (1 - visible) / 2 + y * visible, w, h * visible)


def screen_aspect():
    """width/height of the first monitor (rotation aware), 16:9 if unknown."""
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, check=False).stdout
        m = json.loads(out)[0]
        w, h = m["width"], m["height"]
        return h / w if m.get("transform", 0) % 2 else w / h
    except (OSError, ValueError, KeyError, IndexError):
        return 16 / 9


def clock_overrides():
    try:
        return json.loads(CLOCK_OVERRIDES.read_text())
    except (OSError, ValueError):
        return {}


def clock_position(wall):
    """Where the clock goes: your dragged position, else wallpaper-depth's guess."""
    override = clock_overrides().get(str(wall))
    if override:
        return tuple(override)
    try:
        meta = json.loads(depth_path(wall).with_suffix(".json").read_text())
        return (meta["x"], meta["y"])
    except (OSError, ValueError, KeyError):
        return DEFAULT_CLOCK


def save_clock(wall, pos):
    overrides = clock_overrides()
    if pos is None:
        overrides.pop(str(wall), None)
    else:
        overrides[str(wall)] = [round(pos[0], 4), round(pos[1], 4)]
    CLOCK_OVERRIDES.parent.mkdir(parents=True, exist_ok=True)
    CLOCK_OVERRIDES.write_text(json.dumps(overrides, indent=1))


def luminance(rgb):
    """WCAG relative luminance of an (r, g, b) tuple in 0..1."""
    lin = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in rgb]
    return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]


def contrast(a, b):
    hi, lo = sorted((luminance(a), luminance(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


def to_hex(rgb):
    return "#" + "".join(f"{round(c * 255):02x}" for c in rgb)


def magick_colors(cmd, args):
    """Run an ImageMagick histogram; return [(count, (r, g, b)), ...] in 0..1."""
    out = subprocess.run([cmd, *args, "-format", "%c", "histogram:info:"], capture_output=True, text=True).stdout
    colors = []
    for line in out.splitlines():
        # "   1234: (12,34,56) #0C2238 srgb(12,34,56)"
        m = re.match(r"\s*(\d+):.*#([0-9A-Fa-f]{6})", line)
        if m:
            h = m.group(2)
            colors.append((int(m.group(1)), tuple(int(h[i : i + 2], 16) / 255 for i in (0, 2, 4))))
    return colors


def hex_rgb(hex_color):
    h = hex_color.lstrip("#")
    return tuple(int(h[i : i + 2], 16) / 255 for i in (0, 2, 4))


# The helpers below take one background colour or a list of them (the slices of
# a mixed background, e.g. half subject, half ground) and satisfy the worst one.


def _bgs(bg):
    return bg if isinstance(bg, list) else [bg]


def worst_contrast(fg, bg):
    return min(contrast(fg, b) for b in _bgs(bg))


def light_on(bg):
    """True if light text reads better than dark over bg."""
    return worst_contrast((1, 1, 1), bg) >= worst_contrast((0, 0, 0), bg)


def readable_text(hue, bg):
    """Almost white/black, tinted with the wallpaper's hue, whichever reads over bg."""
    return colorsys.hls_to_rgb(hue, 0.93 if light_on(bg) else 0.12, 0.35)


def readable_accent(rgb, bg, ratio=4.5):
    """The accent with its lightness pushed away from bg until it reaches ratio."""
    hue, light, sat = colorsys.rgb_to_hls(*rgb)
    sat = max(sat, 0.45)
    step = 0.03 if light_on(bg) else -0.03
    accent = colorsys.hls_to_rgb(hue, light, sat)
    while worst_contrast(accent, bg) < ratio and 0.05 < light < 0.95:
        light += step
        accent = colorsys.hls_to_rgb(hue, light, sat)
    return accent


def extract_colors(wall):
    """Pick clock text/accent colours that match the wallpaper and stay readable
    over the area behind the clock. Cached next to the thumbnails, per position."""
    cx, cy = clock_position(wall)
    cache = THUMB_DIR / f"{get_hash(wall)}.colors-{cx:.3f}-{cy:.3f}.json"
    try:
        return json.loads(cache.read_text())
    except (OSError, ValueError):
        pass
    cmd = image_cmd()
    if cmd is None:
        return None

    identify = [cmd, "identify"] if cmd == "magick" else ["identify"]  # IM7 vs IM6
    size = subprocess.run([*identify, "-format", "%w %h", f"{wall}[0]"], capture_output=True, text=True).stdout.split()
    if len(size) != 2:
        return None
    img_w, img_h = map(int, size)
    x, y, w, h = region_in_image(clock_region(cx, cy), img_w / img_h, screen_aspect())
    region = [f"{wall}[0]", "-resize", "256x256!", "-crop", f"{w * 256:.0f}x{h * 256:.0f}+{x * 256:.0f}+{y * 256:.0f}"]
    behind = magick_colors(cmd, region + ["-scale", "1x1!"])
    palette = magick_colors(cmd, [f"{wall}[0]", "-resize", "128x128", "-colors", "12"])
    if not behind or not palette:
        return None
    bg = behind[0][1]

    # accent: frequent *and* vivid; ignore near-black/near-white
    def score(entry):
        count, rgb = entry
        hue, light, sat = colorsys.rgb_to_hls(*rgb)
        return count * sat * (0.15 < light < 0.9)

    vivid = max(palette, key=score)[1]
    # the date reads at WCAG 4.5:1; the time is near-white/black in the same hue
    accent = readable_accent(vivid, bg)
    text = readable_text(colorsys.rgb_to_hls(*vivid)[0], bg)
    colors = {"text": to_hex(text), "accent": to_hex(accent), "vivid": to_hex(vivid), "background": to_hex(bg)}
    cache.write_text(json.dumps(colors))
    return colors


# --- backends -----------------------------------------------------------------


def process_running(*names):
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if Path(f"/proc/{pid}/comm").read_text().strip() in names:
                return True
        except OSError:
            pass
    return False


def backend():
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        if process_running("qs", "quickshell"):
            return "quickshell"
        # at login qs and `restore` start together: if qs is installed and hyprpaper
        # isn't running, qs is the backend that is still coming up
        if shutil.which("qs") and not process_running("hyprpaper"):
            return "quickshell"
        return "hyprpaper"
    return "feh"


def focused_monitor():
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, check=False).stdout
        return next((m["name"] for m in json.loads(out) if m.get("focused")), "")
    except (OSError, ValueError, KeyError):
        return ""


def hypr_monitors():
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, check=False).stdout
        return [m["name"] for m in json.loads(out)]
    except (OSError, ValueError, KeyError):
        return []


def write_hyprpaper_conf(wall):
    """Persist the wallpaper so hyprpaper paints it on its first frame at login
    (Hyprland execs: hyprpaper -c "$HYPRPAPER_CONF")."""
    # One block per output; an empty name (all outputs) only if hyprctl can't list them
    lines = ["# Generated by wallpaper-manager -- do not edit", "ipc = true", "splash = false"]
    for mon in hypr_monitors() or [""]:
        lines += ["", "wallpaper {", f"    monitor = {mon}", f"    path = {wall}", "    fit_mode = cover", "}"]
    HYPRPAPER_CONF.write_text("\n".join(lines) + "\n")


def hyprpaper_set(wall):
    """Set the wallpaper over hyprpaper IPC; True once every monitor shows it.

    hyprpaper 0.8 silently ignores an empty monitor name (",path": empty reply,
    exit 0, wallpaper unchanged), so address each monitor and verify the result
    with listactive instead of trusting the reply.
    """
    monitors = hypr_monitors()
    for mon in monitors:
        subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f"{mon},{wall},cover"], capture_output=True, check=False)
    out = subprocess.run(["hyprctl", "hyprpaper", "listactive"], capture_output=True, text=True, check=False).stdout
    # listactive lines: "<monitor>: <path>"
    active = dict(line.split(": ", 1) for line in out.splitlines() if ": " in line)
    return bool(monitors) and all(active.get(mon) == str(wall) for mon in monitors)


def foreground_info(wall):
    """Cutout path (or None) and a revision that changes when it is rebuilt in
    place, so Quickshell knows to reload the same path."""
    fg = depth_path(wall)
    try:
        return str(fg), fg.stat().st_mtime_ns
    except OSError:
        return None, 0


def write_state(wall):
    """Tell the Quickshell wallpaper what to show; foreground only if it matches."""
    fg, rev = foreground_info(wall)
    cx, cy = clock_position(wall)
    state = {
        "wallpaper": str(wall),
        "foreground": fg,
        "foregroundRev": rev,
        "colors": extract_colors(wall),
        "clock": {"x": cx, "y": cy},
    }
    # Written in place (not rename) so Quickshell's file watcher keeps its inode;
    # the QML side ignores a half-written read and picks up the next change.
    with open(STATE_FILE, "w") as f:
        json.dump(state, f)
    write_lock_conf(wall, fg, rev, state["colors"], (cx, cy))


def monitor_size():
    """Pixel size of the first monitor (rotation aware), 1920x1080 if unknown."""
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, check=False).stdout
        m = json.loads(out)[0]
        w, h = m["width"], m["height"]
        return (h, w) if m.get("transform", 0) % 2 else (w, h)
    except (OSError, ValueError, KeyError, IndexError):
        return (1920, 1080)


def lock_cutout(fg, rev, size):
    """The cutout cropped to the screen exactly as hyprlock crops its background,
    and dimmed like it, so hyprlock's image widget can lay it over pixel for pixel."""
    cmd = image_cmd()
    if fg is None or cmd is None:
        return None
    w, h = size
    meta = LOCK_FG.with_suffix(".json")
    key = {"foreground": fg, "rev": rev, "size": [w, h], "brightness": LOCK_BRIGHTNESS}
    try:
        if json.loads(meta.read_text()) == key and LOCK_FG.exists():
            return LOCK_FG
    except (OSError, ValueError):
        pass
    tmp = LOCK_FG.with_suffix(".tmp.png")
    rc = subprocess.run(
        [cmd, fg, "-background", "none", "-resize", f"{w}x{h}^", "-gravity", "center", "-extent", f"{w}x{h}",
         "-channel", "RGB", "-evaluate", "multiply", str(LOCK_BRIGHTNESS), "+channel", f"png:{tmp}"],
        stderr=subprocess.DEVNULL, check=False,
    ).returncode  # fmt: skip
    if rc != 0:
        return None
    tmp.replace(LOCK_FG)
    meta.write_text(json.dumps(key))
    return LOCK_FG


class LockBackdrop:
    """A small copy of what hyprlock shows behind its widgets -- the background
    dimmed and blurred like hyprlock.conf does, plus the sharp cutout -- to pick
    each widget's colour from what is really behind it."""

    SIZE = (256, 144)

    def __init__(self, wall, cutout, screen):
        self.path = CACHE_DIR / "lock-backdrop.png"
        self.ok = False
        cmd = image_cmd()
        if cmd is None:
            return
        w, h = self.SIZE
        # same cover-crop as the screen, then the screen's aspect squeezed to 256x144
        crop = f"{screen[0]}x{screen[1]}"
        args = [cmd, f"{wall}[0]", "-resize", f"{crop}^", "-gravity", "center", "-extent", crop,
                "-resize", f"{w}x{h}!", "-blur", "0x2", "-evaluate", "multiply", str(LOCK_BRIGHTNESS)]  # fmt: skip
        if cutout:
            args += ["(", str(cutout), "-resize", f"{w}x{h}!", ")", "-composite"]
        self.ok = subprocess.run([*args, f"png:{self.path}"], stderr=subprocess.DEVNULL).returncode == 0
        self.cmd = cmd
        self.alpha = CACHE_DIR / "lock-alpha.png"
        self.has_alpha = bool(cutout) and subprocess.run(
            [cmd, str(cutout), "-resize", f"{w}x{h}!", "-alpha", "extract", f"png:{self.alpha}"],
            stderr=subprocess.DEVNULL,
        ).returncode == 0

    @staticmethod
    def _crop(box, size):
        w, h = size
        x0, y0 = max(box[0], 0) * w, max(box[1], 0) * h
        x1, y1 = min(box[2], 1) * w, min(box[3], 1) * h
        return f"{max(x1 - x0, 1):.0f}x{max(y1 - y0, 1):.0f}+{x0:.0f}+{y0:.0f}"

    def coverage(self, box):
        """How much of a screen-fraction box the cutout covers, 0..1."""
        if not self.has_alpha:
            return 0.0
        out = magick_colors(self.cmd, [str(self.alpha), "-crop", self._crop(box, self.SIZE), "+repage", "-scale", "1x1!"])
        return out[0][1][0] if out else 0.0

    def colors(self, box, fallback, slices=5):
        """Average colours of a screen-fraction box (x0, y0, x1, y1), cut into
        vertical slices: a widget over a mixed background gets every part."""
        if not self.ok:
            return [fallback]
        crop = ["-crop", self._crop(box, self.SIZE), "+repage", "-scale", f"{slices}x1!"]
        out = subprocess.run([self.cmd, str(self.path), *crop, "txt:-"], capture_output=True, text=True).stdout
        # txt: lines "x,y: (r,g,b...)  #RRGGBB  ..."
        found = [hex_rgb(m.group(1)) for m in re.finditer(r"#([0-9A-Fa-f]{6})", out)]
        return found or [fallback]


def hypr_block(kind, props, comment=None):
    """One hyprlang widget block, e.g. label { ... }."""
    lines = [f"# {comment}"] if comment else []
    lines += [kind + " " + "{", *(f"    {k} = {v}" for k, v in props.items()), "}"]
    return "\n".join(lines)


def rgba(rgb, alpha=1.0):
    return f"rgba({to_hex(rgb).lstrip('#')}{round(alpha * 255):02x})"


def write_lock_conf(wall, fg, rev, colors, pos):
    """hyprlock's half of the depth effect: blurred background (hyprlock.conf) ->
    clock -> sharp cutout -> greeting, password, quote, now playing. The clock
    matches the Quickshell one (Clock.qml); the rest follows it: stacked under it
    on the same centre line (above it when it sits low). Every widget's colour is
    picked against what is behind it on the lock screen, in the wallpaper's hue."""
    w, h = monitor_size()
    s = h / 1440  # the static layout was designed at 1440p
    colors = colors or {}
    vivid = hex_rgb(colors.get("vivid", colors.get("accent", "{{ .colorScheme.mauve }}")))
    hue = colorsys.rgb_to_hls(*vivid)[0]
    pt = 0.75  # hyprlock font_size is in points at 96 dpi

    # Clock.qml: time 0.26 h px, date 0.045 h px; the time box is ~1.32x its font
    # size tall and the date tucks 0.02 h into it. Kept on screen (time ~0.42 w).
    cx = min(max(pos[0], 0.21), 0.79)
    x = round((cx - 0.5) * w)
    clock_top = min(max(pos[1], 0.0), 0.6) * h
    date_top = clock_top + 0.323 * h
    clock_bottom = date_top + 0.06 * h

    # greeting, password, quote stacked as one column; heights in px
    greet_h, input_h, quote_h, gap = 0.04 * h, 60 * s, 0.085 * h, 0.03 * h
    stack_h = greet_h + gap + input_h + gap + quote_h
    if clock_bottom + 0.04 * h + stack_h <= 0.92 * h:
        stack_top = clock_bottom + 0.04 * h  # room below the clock
    else:
        stack_top = max(clock_top - 0.04 * h - stack_h, 0.03 * h)  # clock sits low: go above
    greet_top = stack_top
    input_top = greet_top + greet_h + gap
    quote_top = input_top + input_h + gap
    # now playing on the edge the column leaves free
    music_bottom = quote_top + quote_h < 0.88 * h
    music_top = 0.93 * h if music_bottom else 0.03 * h

    # what sits behind each widget (screen-fraction boxes around its centre line)
    cutout = lock_cutout(fg, rev, (w, h))
    backdrop = LockBackdrop(wall, cutout, (w, h))
    mid = cx

    def behind(half_w, top, height):
        return backdrop.colors((mid - half_w, top / h, mid + half_w, (top + height) / h), (0.1, 0.1, 0.1))

    def text_on(bg):
        return readable_text(hue, bg)

    clock_bg = behind(0.21, clock_top, 0.343 * h)
    date_bg = behind(0.15, date_top, 0.06 * h)
    greet_bg = behind(0.10, greet_top, greet_h)
    input_bg = behind(160 * s / w, input_top, input_h)
    quote_bg = behind(0.20, quote_top, quote_h)
    music_bg = behind(0.25, music_top, 0.04 * h)

    # a busy subject behind the column (the sharp cutout under 15%+ of it; calm
    # scenes measure 0-0.11, subjects 0.28+): give the column a translucent card
    # and pick its text against that card instead
    pad = 0.025 * h
    col_w = 0.40
    card = None
    if backdrop.coverage((mid - col_w / 2, stack_top / h, mid + col_w / 2, (stack_top + stack_h) / h)) > 0.15:
        card_rgb = colorsys.hls_to_rgb(hue, 0.08, 0.3)  # dark glass reads best over busy detail
        card = {"monitor": "", "size": f"{round(col_w * w)}, {round(stack_h + 2 * pad)}",
                "color": rgba(card_rgb, 0.55), "rounding": round(28 * s), "border_size": max(1, round(2 * s)),
                "border_color": rgba(readable_accent(vivid, card_rgb, 3), 0.5),
                "position": f"{x}, {-round(stack_top - pad)}", "halign": "center", "valign": "top",
                "zindex": 3}  # fmt: skip
        greet_bg = input_bg = quote_bg = card_rgb

    def halo(bg):
        # a soft shadow opposite to the text: dark behind light text, light behind dark
        return {"shadow_passes": 2, "shadow_size": round(5 * s), "shadow_boost": 1.2,
                "shadow_color": "rgba(00000099)" if light_on(bg) else "rgba(ffffff99)"}  # fmt: skip

    def label(text_, color, size_px, font, top, bg, extra=None):
        return {"monitor": "", "text": text_, "color": color, "font_size": round(size_px * pt),
                "font_family": font, "position": f"{x}, {-round(top)}", "halign": "center",
                "valign": "top", **(extra or {}), **halo(bg)}  # fmt: skip

    input_text = text_on(input_bg)
    widgets = [
        ("label", label('cmd[update:1000] date +"%H:%M"', rgba(text_on(clock_bg)), 0.26 * h, CLOCK_FONT,
                        clock_top, clock_bg, {"zindex": 1}), "Clock (under the cutout: the depth effect) + date"),
        # the date is small text to read, not part of the effect: above the cutout
        ("label", label('cmd[update:60000] date +"%A, %-d %B"', rgba(readable_accent(vivid, date_bg)),
                        0.045 * h, DATE_FONT, date_top, date_bg, {"zindex": 4}), None),
        ("label", label("Welcome back, $USER", rgba(text_on(greet_bg), 0.95), 32 * s, LABEL_FONT, greet_top,
                        greet_bg, {"zindex": 4}), "Greeting, password, quote: one column with the clock"),
        ("input-field", {
            "monitor": "", "size": f"{round(340 * s)}, {round(input_h)}", "outline_thickness": max(2, round(3 * s)),
            "dots_size": 0.25, "dots_spacing": 0.3, "dots_center": "true",
            "outer_color": rgba(readable_accent(vivid, input_bg, 3)),
            # the fill contrasts with the text: dark glass for light text, light for dark
            "inner_color": rgba(colorsys.hls_to_rgb(hue, 0.1 if light_on(input_bg) else 0.92, 0.25), 0.6),
            "font_color": rgba(input_text), "check_color": rgba(hex_rgb("{{ .colorScheme.yellow }}")),
            "fail_color": rgba(hex_rgb("{{ .colorScheme.red }}")),
            "capslock_color": rgba(hex_rgb("{{ .colorScheme.peach }}")),
            "fade_on_empty": "false", "rounding": round(30 * s),
            # "##" is hyprlang's escape for a literal "#" (a single "#" starts a comment)
            "placeholder_text": f'<span foreground="##{to_hex(input_text).lstrip("#")}" fgalpha="60%">Password</span>',
            "fail_text": "<i>$FAIL ($ATTEMPTS)</i>",
            "position": f"{x}, {-round(input_top)}", "halign": "center", "valign": "top", "zindex": 4,
        }, None),  # fmt: skip
        ("label", label("cmd[update:300000] ~/.local/bin/lock-quote.sh", rgba(text_on(quote_bg), 0.85), 24 * s,
                        QUOTE_FONT, quote_top, quote_bg, {"text_align": "center", "zindex": 4}), None),
        ("label", {
            **label("cmd[update:2000] ~/.local/bin/lock-nowplaying.sh", rgba(text_on(music_bg), 0.85), 22 * s,
                    LABEL_FONT, 0, music_bg, {"zindex": 4}),
            "position": f"{x}, {round(0.04 * h) if music_bottom else -round(0.03 * h)}",
            "valign": "bottom" if music_bottom else "top",
        }, "Now playing (in a script: hyprlang parses playerctl's double-brace format)"),  # fmt: skip
    ]
    if card:
        widgets.insert(2, ("shape", card, "Card behind the column: the subject behind it is busy"))
    blocks = ["# Generated by wallpaper-manager -- do not edit (rewritten on every wallpaper change)"]
    blocks += [hypr_block(kind, props, comment) for kind, props, comment in widgets]
    if cutout:
        image = {"monitor": "", "path": cutout, "size": min(w, h), "rounding": 0, "border_size": 0,
                 "position": "0, 0", "halign": "center", "valign": "center", "zindex": 2}  # fmt: skip
        blocks.append(hypr_block("image", image, "The depth-effect cutout, pixel-aligned with the background"))
    LOCK_CONF.parent.mkdir(parents=True, exist_ok=True)
    LOCK_CONF.write_text("\n\n".join(blocks) + "\n")


def link(target, name):
    tmp = CACHE_DIR / f".{name}.tmp"
    tmp.unlink(missing_ok=True)
    tmp.symlink_to(target)
    tmp.replace(CACHE_DIR / name)


# --- depth layer ----------------------------------------------------------------


def start_depth(wall):
    """Generate the foreground cutout in the background, then refresh state.json."""
    fg = depth_path(wall)
    # .none: the model found no subject in this wallpaper, don't retry
    if fg.exists() or fg.with_suffix(".none").exists() or not DEPTH_TOOL.exists():
        return
    if not shutil.which("uv"):
        if not NO_UV_FLAG.exists():
            notify("Wallpaper depth skipped", "Install uv (mise) to generate the depth layer.")
            NO_UV_FLAG.touch()
        return
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_depth", str(wall)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def run_depth(wall, force=False):
    cmd = ["nice", "-n", "19", str(DEPTH_TOOL), str(wall), "--aspect", f"{screen_aspect():.5f}"]
    cmd += ["--force"] if force else []
    override = clock_overrides().get(str(wall))
    if override:  # keep your position when the layer is rebuilt
        cmd += ["--clock", f"{override[0]},{override[1]}"]
    rc = subprocess.run(cmd, check=False).returncode
    # only refresh if the user hasn't moved on to another wallpaper meanwhile
    if rc == 0 and current_wallpaper() == wall:
        write_state(wall)
    return rc


def move_clock(wall, pos):
    """Save (or with None, forget) the clock position and refit the depth layer
    to it: only re-thresholds wallpaper-depth's cached maps, no model run."""
    save_clock(wall, pos)
    if not DEPTH_TOOL.exists() or not shutil.which("uv"):
        if current_wallpaper() == wall:
            write_state(wall)
        return 0
    if pos is None:
        # back to the guess: drop the manual result, keep the cached maps
        for suffix in (".png", ".none", ".json"):
            depth_path(wall).with_suffix(suffix).unlink(missing_ok=True)
    rc = run_depth(wall)
    if current_wallpaper() == wall:
        write_state(wall)
    return rc


# --- commands ---------------------------------------------------------------------


def set_wallpaper(wall):
    wall = Path(wall).expanduser().resolve()
    if not wall.is_file():
        die(f"File not found: {wall}")
    generate_cache(wall)

    CURRENT_WALL.write_text(f"{wall}\n")
    h = get_hash(wall)
    link(THUMB_DIR / f"{h}.thumb", "wall.thmb")
    link(THUMB_DIR / f"{h}.blur", "wall.blur")
    link(wall, "wall.current")

    mode = backend()
    if mode == "feh":
        if not shutil.which("feh"):
            die("feh not found")
        subprocess.run(["feh", "--no-fehbg", "--bg-fill", str(wall)], check=False)
    else:
        # kept current for both: the next login may start either one
        write_hyprpaper_conf(wall)
        write_state(wall)
        if mode == "hyprpaper" and not hyprpaper_set(wall):
            die(f"hyprpaper rejected {wall.name}")
        start_depth(wall)

    notify("Wallpaper Changed", wall.name)


def restore_wallpaper():
    wall = current_wallpaper()
    if wall is None or not wall.is_file():
        return
    mode = backend()
    if mode == "feh":
        if shutil.which("feh"):
            subprocess.run(["feh", "--no-fehbg", "--bg-fill", str(wall)], check=False)
        return
    write_hyprpaper_conf(wall)
    write_state(wall)
    if mode == "hyprpaper":
        # hyprpaper normally starts with this wallpaper already (see
        # write_hyprpaper_conf); retry IPC until it answers, as a fallback.
        for _ in range(50):
            if hyprpaper_set(wall):
                break
            time.sleep(0.1)
    start_depth(wall)


def step_wallpaper(offset):
    walls = list_wallpapers()
    cur = current_wallpaper()
    idx = walls.index(cur) + offset if cur in walls else 0
    set_wallpaper(walls[idx % len(walls)])


def list_json():
    cur = current_wallpaper()
    items = []
    for wall in list_wallpapers():
        fg = depth_path(wall)
        fg_path, rev = foreground_info(wall)
        cx, cy = clock_position(wall)
        items.append(
            {
                "path": str(wall),
                "name": wall.name,
                "thumb": str(generate_cache(wall)),
                "foreground": fg_path,
                "foregroundRev": rev,
                # ready | none (no subject found) | pending (made on apply)
                "depth": "ready" if fg.exists() else "none" if fg.with_suffix(".none").exists() else "pending",
                "current": wall == cur,
                "colors": extract_colors(wall),
                "clock": {"x": cx, "y": cy, "manual": str(wall) in clock_overrides()},
            }
        )
    json.dump(items, sys.stdout)


def select_rofi():
    walls = list_wallpapers()
    by_name = {}
    entries = ""
    for wall in walls:
        thumb = generate_cache(wall)
        # Format: display_name\0icon\x1fthumbnail_path
        entries += f"{wall.name}\0icon\x1f{thumb}\n"
        by_name[wall.name] = wall
    override = (
        "window{width:100%;} listview{columns:5;spacing:5em;} "
        "element{border-radius:10px; orientation:vertical;} "
        "element-icon{size:28em;border-radius:0em;} element-text{padding:1em;}"
    )
    out = subprocess.run(
        [
            "rofi", "-dmenu",
            "-display-column-separator", ":::",
            "-display-columns", "1",
            "-theme-str", f'* {"{"}font: "{ROFI_FONT}";{"}"}',
            "-theme-str", override,
            "-theme", "~/.config/rofi/styles/selector.rasi",
            "-show-icons",
        ],
        input=entries,
        capture_output=True,
        text=True,
        check=False,
    )  # fmt: skip
    selected = out.stdout.strip()
    if selected in by_name:
        set_wallpaper(by_name[selected])


def select_wallpaper():
    if backend() == "quickshell":
        cmd = ["qs", "ipc", "call", "picker", "toggle", focused_monitor()]
        rc = subprocess.run(cmd, capture_output=True, check=False).returncode
        if rc == 0:
            return
    select_rofi()


def main():
    THUMB_DIR.mkdir(parents=True, exist_ok=True)
    DEPTH_DIR.mkdir(parents=True, exist_ok=True)

    aliases = {"s": "select", "n": "next", "p": "prev", "r": "random"}
    argv = sys.argv[1:] or ["select"]
    argv[0] = aliases.get(argv[0], argv[0])

    parser = argparse.ArgumentParser(prog="wallpaper-manager", description="Wallpaper manager (Quickshell/hyprpaper/feh)")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("select", help="pick a wallpaper (Quickshell picker, rofi fallback)")
    sub.add_parser("set", help="set a specific wallpaper").add_argument("path")
    sub.add_parser("next", help="switch to the next wallpaper")
    sub.add_parser("prev", help="switch to the previous wallpaper")
    sub.add_parser("random", help="set a random wallpaper")
    sub.add_parser("restore", help="restore the last wallpaper (startup)")
    sub.add_parser("list", help="list wallpapers as JSON (for the picker)").add_argument("--json", action="store_true")
    depth = sub.add_parser("depth", help="generate the depth cutout (default: current)")
    depth.add_argument("path", nargs="?")
    depth.add_argument("--force", action="store_true")
    clock = sub.add_parser("clock", help="move the clock for a wallpaper (the picker's drag)")
    clock.add_argument("path")
    clock.add_argument("position", nargs="+", help="X Y (centre x, top y; screen fractions) or 'reset'")
    sub.add_parser("_depth").add_argument("path")  # internal: background job
    args = parser.parse_args(argv)

    match args.cmd:
        case "select":
            select_wallpaper()
        case "set":
            set_wallpaper(args.path)
        case "next":
            step_wallpaper(1)
        case "prev":
            step_wallpaper(-1)
        case "random":
            set_wallpaper(random.choice(list_wallpapers()))
        case "restore":
            restore_wallpaper()
        case "list":
            list_json()
        case "depth":
            wall = Path(args.path).expanduser().resolve() if args.path else current_wallpaper()
            if wall is None or not wall.is_file():
                die("No wallpaper to process")
            sys.exit(run_depth(wall, args.force))
        case "clock":
            wall = Path(args.path).expanduser().resolve()
            if args.position == ["reset"]:
                sys.exit(move_clock(wall, None))
            x, y = (min(max(float(v), 0.0), 1.0) for v in args.position[:2])
            sys.exit(move_clock(wall, (x, y)))
        case "_depth":
            run_depth(Path(args.path))


if __name__ == "__main__":
    main()

